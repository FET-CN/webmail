{
  "tasks": {
    "dev": "deno run --unstable-kv --allow-env --allow-net --allow-read --allow-write --watch server.ts",
    "start": "deno run --unstable-kv --allow-env --allow-net --allow-read --allow-write server.ts",
    "check": "deno check ../core/*.ts ../protocol/*.ts server.ts",
    "test": "deno test --allow-env --allow-net ../core ../protocol ../cloudflare/websocket_test.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  }
}
